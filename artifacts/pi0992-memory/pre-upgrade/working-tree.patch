+/* Mobile Markdown tables: readable 2–3 column tables stay in-place; genuinely
+   wide tables scroll inside their own frame instead of stretching/clipping chat. */
+.markdown-table-frame {
+  width: 100%;
+  max-width: 100%;
+  margin: 12px 0 16px;
+  overflow: hidden;
+  border: 1px solid var(--border-default);
+  border-radius: 12px;
+  background-color: var(--bg-surface);
+  box-shadow: var(--shadow-sm);
+}
+
+.markdown-table-scroll {
+  width: 100%;
+  max-width: 100%;
+  overflow-x: auto;
+  overflow-y: hidden;
+  overscroll-behavior-x: contain;
+  -webkit-overflow-scrolling: touch;
+  scrollbar-width: thin;
+}
+
+.markdown-table-scroll:focus-visible {
+  outline: 2px solid var(--accent-border);
+  outline-offset: -2px;
+}
+
+.markdown-table-scroll table {
+  width: 100%;
+  min-width: 100%;
+  margin: 0;
+  border-collapse: separate;
+  border-spacing: 0;
+  table-layout: auto;
+  font-size: 13px;
+  line-height: 1.45;
+  color: var(--fg);
+}
+
+.markdown-table-scroll th,
+.markdown-table-scroll td {
+  min-width: 88px;
+  max-width: 260px;
+  padding: 9px 10px;
+  vertical-align: top;
+  white-space: normal;
+  overflow-wrap: anywhere;
+  word-break: normal;
+  hyphens: auto;
+}
+
+.markdown-table-scroll th:first-child,
+.markdown-table-scroll td:first-child {
+  min-width: 62px;
+}
+
+.markdown-table-scroll th:not(:last-child),
+.markdown-table-scroll td:not(:last-child) {
+  border-right: 1px solid var(--border-subtle);
+}
+
+.markdown-table-scroll thead th {
+  border-bottom: 1px solid var(--border-default);
+  background-color: var(--bg-subtle);
+  color: var(--fg-secondary);
+  font-size: 12.5px;
+  font-weight: 600;
+  text-align: left;
+}
+
+.markdown-table-scroll tbody tr:not(:last-child) > td {
+  border-bottom: 1px solid var(--border-subtle);
+}
+
+.markdown-table-scroll tbody tr:nth-child(even) > td {
+  background-color: rgba(243, 239, 234, 0.34);
+}
+
+.markdown-table-scroll th[align="center"],
+.markdown-table-scroll td[align="center"] { text-align: center; }
+.markdown-table-scroll th[align="right"],
+.markdown-table-scroll td[align="right"] { text-align: right; }
+.markdown-table-scroll th[align="left"],
+.markdown-table-scroll td[align="left"] { text-align: left; }
+
+.markdown-table-scroll th > :first-child,
+.markdown-table-scroll td > :first-child { margin-top: 0; }
+.markdown-table-scroll th > :last-child,
+.markdown-table-scroll td > :last-child { margin-bottom: 0; }
+
+.markdown-table-scroll td ul,
+.markdown-table-scroll td ol {
+  margin: 0.2em 0;
+  padding-left: 18px;
+}
+
+.markdown-table-scroll td code:not(pre code),
+.markdown-table-scroll th code:not(pre code) {
+  font-size: 11.5px;
+  white-space: normal;
+  overflow-wrap: anywhere;
+}
+
