{
  "language": "zh-CN",
  "permissionMode": "auto",
  "defaultModelId": "deepseek/deepseek-flash",
  "proxyUrl": "",
  "memoryEnabled": true,
  "memoryGatewayEnabled": true,
  "memoryGatewayWriteEnabled": true,
  "memoryGatewayPort": 3351,
  "remoteAccessEnabled": true,
  "remoteAccessPort": 3352,
  "remoteAccessBaseUrl": "",
  "remoteAccessBindMode": "lan",
  "backupFiles": true,
  "theme": "system",
  "thinkingLevel": "max",
  "skillModeFilterEnabled": true,
  "closeToTray": true,
  "notificationPreferences": {
    "inAppEnabled": true,
    "desktopEnabled": true,
    "desktopBackgroundOnly": true,
    "taskCompleted": true,
    "taskFailed": true,
    "actionRequired": true,
    "automationCompleted": true,
    "automationFailed": true,
    "projectAttention": true,
    "runtimeFailed": true
  },
  "fontSize": 105,
  "fontFamily": "'Source Han Sans SC', 'Noto Sans SC', sans-serif",
  "uiFontSize": 15,
  "codeFontSize": 15,
  "uiFontFamily": "\"Microsoft YaHei\"",
  "codeFontFamily": "\"MesloLGM Nerd Font Mono\"",
  "codeTheme": "vitesse",
  "shellIsolationLevel": "guarded",
  "compactionTriggerRatio": 0.8,
  "conversationBranchEnabled": true,
  "nativeRuntimeShadowEnabled": false,
  "disabledExternalAgentIds": [
    "codex",
    "claude",
    "cline",
    "dim"
  ],
  "hideUnavailableExternalAgents": false,
  "executionControlPlane": {
    "policyVersion": 3,
    "defaultNativeBackend": "direct",
    "defaultShellBackend": null,
    "fallbackPolicy": "disabled",
    "pathMappingConfig": {
      "windowsDriveMountRoot": "/mnt",
      "enableWindowsDriveMapping": true
    },
    "powershellTransport": "encoded_command",
    "outputEncoding": "auto",
    "timeoutMs": 120000
  },
  "systemToolPolicy": "always_confirm",
  "defaultProvider": "deepseek",
  "defaultModel": "deepseek-flash",
  "shellPath": "C:\\Program Files\\PowerShell\\7\\pwsh.exe",
  "defaultThinkingLevel": "max",
