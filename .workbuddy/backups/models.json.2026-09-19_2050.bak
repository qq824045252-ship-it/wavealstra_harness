{
  "providers": {
    "opencode": {
      "name": "OpenCode Zen",
      "baseUrl": "https://opencode.ai/zen/v1",
      "api": "openai-completions",
      "modelDiscovery": {
        "mode": "openai-compatible"
      },
      "models": [
        {
          "id": "deepseek-v4.1-flash",
          "name": "DeepSeek V4.1 Flash",
          "reasoning": true,
          "input": ["text"],
          "contextWindow": 1000000,
          "maxTokens": 384000
        }
      ]
    }
  }
}
