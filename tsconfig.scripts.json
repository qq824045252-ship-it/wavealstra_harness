{
  // scripts/（测试与工具脚本）的口径：这些文件不在 tsconfig.node/web 的 include 里，
  // 过去引用主进程服务契约发生漂移时没有任何静态检查能发现。
  // 与 renderer 使用相同的路径和浏览器声明，保证测试引用真实契约。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": false,
    "strictNullChecks": true,
    "moduleDetection": "force",
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./src/renderer/src/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["scripts/**/*.ts", "scripts/**/*.tsx", "src/preload/index.d.ts", "src/renderer/src/**/*.d.ts"]
}
